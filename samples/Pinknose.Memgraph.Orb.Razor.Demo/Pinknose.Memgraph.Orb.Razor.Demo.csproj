<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- By project reference, so a change to the library's API breaks this at compile time
         rather than in someone's browser. -->
    <ProjectReference Include="..\..\Pinknose.Memgraph.Orb.Razor\Pinknose.Memgraph.Orb.Razor.csproj" />
  </ItemGroup>

</Project>
