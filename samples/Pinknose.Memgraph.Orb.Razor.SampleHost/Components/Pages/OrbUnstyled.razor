@page "/orb-unstyled"
@rendermode InteractiveServer

<PageTitle>Orb Unstyled</PageTitle>

<h1>Orb Unstyled</h1>

<p>
    Plain <code>OrbNode</code>/<code>OrbEdge</code> instances with neither <code>Label</code>
    nor <code>Style</code> set -- the case that trips the "cleared style" regression, since
    the projector emits a null style for these and Orb's own default must be what renders.
</p>

<OrbGraph TNode="OrbNode" TEdge="OrbEdge"
          Nodes="@_nodes"
          Edges="@_edges"
          Height="600px"
          class="border rounded"
          data-orb-test="true" />

@code {
    private List<OrbNode> _nodes =
    [
        new("n1"),
        new("n2"),
        new("n3")
    ];

    private List<OrbEdge> _edges =
    [
        new("e1", "n1", "n2"),
        new("e2", "n2", "n3")
    ];
}
