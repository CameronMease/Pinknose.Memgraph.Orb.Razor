@page "/orb-demo"
@rendermode InteractiveServer

<PageTitle>Orb Demo</PageTitle>

<h1>Orb Demo</h1>

<p>Sample rendering of <code>Pinknose.Memgraph.Orb.Razor.OrbGraph</code>.</p>

<OrbGraph Height="600px" DataJson="@DemoDataJson" SettingsJson="@DemoSettingsJson" />

