@inject NavigationManager Nav

@* The entire demo surface lives here, in the WebAssembly project, so that BOTH sample pages
   render the exact same component and can only differ by @rendermode. Anything added to the
   demo -- new controls, new graph operations -- must go in this file, never in a page:
   OrbSamplePagesTests enforces that the pages stay thin wrappers. *@

<p>
    Selected: <strong id="selection-label">@(_selected?.FullName ?? "none")</strong> |
    Hovered: <strong id="hover-label">@(_hovered?.FullName ?? "none")</strong> |
    Styling: <strong id="style-state">@_styling.ToString().ToLowerInvariant()</strong>
</p>

<button id="recenter-btn" class="btn btn-secondary" @onclick="RecenterAsync">Recenter</button>
<button id="remove-btn" class="btn btn-secondary" @onclick="RemoveCarol">Remove Carol</button>
<button id="clear-settings-btn" class="btn btn-secondary" @onclick="ClearSettings">Clear settings</button>
<button id="style-toggle-btn" class="btn btn-secondary" @onclick="CycleStyling">
    Styling: @_styling.ToString().ToLowerInvariant()
</button>

<OrbGraph TNode="Person" TEdge="Relationship"
          @ref="_graph"
          Nodes="@_people"
          Edges="@_relationships"
          Height="600px"
          class="border rounded"
          data-orb-test="true"
          Settings="@_settings"
          OnNodeClick="@(e => _selected = e.Node)"
          OnNodeHoverEnter="@(e => _hovered = e.Node)"
          OnNodeHoverLeave="@(_ => _hovered = null)" />

@code {
    // Three modes, because the two interesting failure cases are different: None makes both
    // Label and Style null (no style is sent at all), while Labels sends a style that carries
    // only a label -- a partial style, which must not cost the node Orb's other defaults.
    private enum StylingMode
    {
        Full,
        Labels,
        None
    }

    private sealed record Person(
        string EmployeeId,
        string FullName,
        bool IsManager,
        StylingMode Styling) : IOrbNode
    {
        public string Id => EmployeeId;

        public string? Label => Styling == StylingMode.None ? null : FullName;

        public OrbNodeStyle? Style => Styling == StylingMode.Full
            ? new OrbNodeStyle
            {
                Color = IsManager ? "#cc3333" : "#3399cc",
                Size = IsManager ? 12 : 8
            }
            : null;
    }

    private sealed record Relationship(
        string Id,
        string Start,
        string End,
        string Kind,
        StylingMode Styling) : IOrbEdge
    {
        public string? Label => Styling == StylingMode.None ? null : Kind;
    }

    private OrbGraph<Person, Relationship>? _graph;
    private Person? _selected;
    private Person? _hovered;
    private StylingMode _styling = StylingMode.Full;

    private List<Person> _people = [];
    private List<Relationship> _relationships = [];

    // Fps is here purely because it is observably non-default (Orb's default is 60): it gives
    // "Clear settings" something to visibly undo without changing how the demo looks.
    private OrbSettings? _settings = new()
    {
        Render = new OrbRenderSettings { LabelsIsEnabled = true, ShadowIsEnabled = true, Fps = 30 },
        Interaction = new OrbInteractionSettings { IsDragEnabled = true, IsZoomEnabled = true },
        Layout = new OrbForceLayout()
    };

    // Settings going non-null -> null means "I have no opinion any more", so the graph should
    // go back to Orb's own defaults -- the same thing Style = null does for a node.
    private void ClearSettings() => _settings = null;

    protected override void OnInitialized()
    {
        // Read ?styling=full|labels|none here rather than via [SupplyParameterFromQuery],
        // which Blazor only supports on routable (@page) components -- declaring it on the
        // pages would put a feature back into them and let the two drift apart.
        if (Enum.TryParse<StylingMode>(QueryValue(Nav.Uri, "styling"), ignoreCase: true, out var mode))
        {
            _styling = mode;
        }

        _people =
        [
            new("n1", "Alice", true, _styling),
            new("n2", "Bob", false, _styling),
            new("n3", "Carol", false, _styling)
        ];

        _relationships =
        [
            new("e1", "n1", "n2", "KNOWS", _styling),
            new("e2", "n2", "n3", "WORKS_WITH", _styling)
        ];
    }

    private async Task RecenterAsync()
    {
        if (_graph is not null)
        {
            await _graph.RecenterAsync();
        }
    }

    private void RemoveCarol()
    {
        _people = [.. _people.Where(p => p.Id != "n3")];
        _relationships = [.. _relationships.Where(r => r.Start != "n3" && r.End != "n3")];
    }

    // Rebuilds every node and edge in the next mode. Full -> Labels -> None walks the two
    // clearing paths in turn: dropping to a partial (label-only) style, then to no style at
    // all. Both have to land on Orb's defaults rather than on whatever was painted before.
    private void CycleStyling()
    {
        _styling = _styling switch
        {
            StylingMode.Full => StylingMode.Labels,
            StylingMode.Labels => StylingMode.None,
            _ => StylingMode.Full
        };

        _people = [.. _people.Select(p => p with { Styling = _styling })];
        _relationships = [.. _relationships.Select(r => r with { Styling = _styling })];
    }

    private static string? QueryValue(string uri, string name)
    {
        var query = new Uri(uri).Query;

        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = pair.IndexOf('=');
            if (separator > 0 && Uri.UnescapeDataString(pair[..separator]) == name)
            {
                return Uri.UnescapeDataString(pair[(separator + 1)..]);
            }
        }

        return null;
    }
}
