<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Ships the XML docs beside the DLL so consumers get IntelliSense on every public member.
         Also switches on CS1591, which is deliberate: an undocumented public member becomes a
         build warning rather than a silent gap in the package. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- RS0041 flags public API that uses un-annotated (nullable-oblivious) reference types.
         The only offender is BuildRenderTree, which the Razor compiler generates and which
         cannot be annotated from here. RS0016, the rule that actually guards the surface,
         stays on. -->
    <NoWarn>$(NoWarn);RS0041</NoWarn>

    <!-- Errors, not warnings: the point of the guard is that an unrecorded change to the
         public surface stops the build. RS0016 is an addition that was never declared,
         RS0017 an entry whose member no longer exists. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Pinknose.Memgraph.Orb.Razor</PackageId>
    <Authors>Cameron Mease</Authors>
    <!-- Kept in step with LICENSE.txt by hand. The year is first publication, not the current
         year, so this does not roll over on its own. -->
    <Copyright>Copyright (c) 2026 Cameron Mease</Copyright>
    <Description>A Blazor component library wrapping Memgraph's Orb graph visualization library (@memgraph/orb 1.0.2). Renders a force-directed graph from your own domain types through a typed OrbGraph component, with no hand-written JS interop. Verified under both Blazor Server and WebAssembly, including a trimmed publish.</Description>
    <PackageTags>blazor;graph;visualization;memgraph;orb;force-directed;network;razor-class-library</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/CameronMease/Pinknose.Memgraph.Orb.Razor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CameronMease/Pinknose.Memgraph.Orb.Razor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Symbols and source stepping. PublishRepositoryUrl + EmbedUntrackedSources are what let
         a consumer debugging into this package land on the real source. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="Trimming">
    <!-- Permission for a consumer's trimmer, not a target choice: WebAssembly apps publish
         trimmed, and an assembly not marked trimmable is copied through whole, so their users
         download every member of this library whether they reach it or not. Marking it also
         turns on the trim analyzer for this project, which surfaces reflection the trimmer
         cannot follow at build time instead of inside someone else's publish.
         Blazor Server consumers are unaffected; nothing trims their copy. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <!-- The git tag IS the version: MinVer reads the nearest v-prefixed tag, and any commit
         that is not exactly on one packs as a pre-release. NuGet versions are immutable, so a
         version number kept in a file (which can disagree with what was actually tagged and
         released) is a mistake with no fix after the fact. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <!-- Before the first tag exists, builds version as 0.1.0-alpha.N rather than 0.0.0-alpha.N,
         so a package built today already sorts below the 0.1.0 release it is heading for.
         Raise this floor whenever the next planned version moves past it. -->
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
    <!-- Build-time only: it sets the version and ships nothing into the package. -->
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
    <!-- Tracks the public API surface in PublicAPI.*.txt. Adding or changing a public member
         without recording it there fails the build, so a breaking change cannot reach a tag by
         accident. That matters because a published NuGet version can never be replaced. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pinknose.Memgraph.Orb.Razor.Tests" />
  </ItemGroup>

</Project>
