{
  "metadata": [
    {
      "src": [
        {
          "src": "../Pinknose.Memgraph.Orb.Razor/bin/Release/net10.0",
          "files": [
            "Pinknose.Memgraph.Orb.Razor.dll"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "filterConfig.yml"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Pinknose.Memgraph.Orb.Razor",
      "_appTitle": "Pinknose.Memgraph.Orb.Razor",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}